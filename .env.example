# PostgreSQL connection string, contoh lokal:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppic
AUTH_SECRET=replace-with-a-random-secret
# Set true jika provider mewajibkan TLS.
PG_SSL=false
# LEMBUR_STORAGE_DIR=D:/path/to/persistent/lembur
# DISCPAD_XLSX=D:/path/to/DATA DISCPAD.xlsx

# Untuk production di balik tunnel/reverse proxy, isi origin publik dan izinkan forwarded host.
# Atur AUTH_URL pada .env.production.local di server, contoh: https://app.example.com
# AUTH_TRUST_HOST=true
